{
    "name": "strukt/key",
    "description": "Cryptography, signing, and SSL utilities with a CLI, built on the Strukt components.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-openssl": "*",
        "ext-json": "*",
        "strukt/math": "v1.2.0",
        "strukt/console": "v2.0.0",
        "strukt/fs": "v2.0.0"
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Strukt\\": "src/Strukt/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/kcli"
    ],
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage",
        "lint": "find src bin tests -name '*.php' -print0 | xargs -0 -n1 php -l"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "authors": [
        {
            "name": "pitsolu",
            "email": "pitsolu@gmail.com"
        }
    ],
    "version": "1.2.0"
}
