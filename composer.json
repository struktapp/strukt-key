{
    "name": "strukt/key",
    "description": "Cryptography, signing, and SSL utilities with a CLI, built on the Strukt components.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-openssl": "*",
        "ext-json": "*",
        "strukt/math": "dev-main",
        "strukt/console": "dev-main",
        "strukt/fs": "dev-main"
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Strukt\\": "src/Strukt/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../strukt4/math",
            "options": {
                "symlink": false,
                "versions": {
                    "strukt/math": "dev-main"
                }
            }
        },
        {
            "type": "path",
            "url": "../../strukt4/base",
            "options": {
                "symlink": false,
                "versions": {
                    "strukt/base": "dev-main"
                }
            }
        },
        {
            "type": "path",
            "url": "../../strukt4/commons",
            "options": {
                "symlink": false,
                "versions": {
                    "strukt/commons": "dev-main"
                }
            }
        },
        {
            "type": "path",
            "url": "../../strukt4/console",
            "options": {
                "symlink": false,
                "versions": {
                    "strukt/console": "dev-main"
                }
            }
        },
        {
            "type": "path",
            "url": "../../strukt4/fs",
            "options": {
                "symlink": false,
                "versions": {
                    "strukt/fs": "dev-main"
                }
            }
        }
    ],
    "bin": [
        "bin/kcli"
    ],
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage",
        "lint": "find src bin tests -name '*.php' -print0 | xargs -0 -n1 php -l"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "authors": [
        {
            "name": "pitsolu",
            "email": "pitsolu@gmail.com"
        }
    ]
}